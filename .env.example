# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App login gate (single password, no user accounts)
APP_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string

# Telegram bot (from @BotFather) — optional. Preferred: set these from the
# app's Pengaturan -> Telegram Bot page (stored in telegram_settings, with
# webhook registration handled automatically). Only needed as fallback when
# you'd rather configure via env vars.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# AI: no env vars needed. The Advisor AND receipt OCR share one key set from
# Pengaturan -> AI Advisor (Gemini or any OpenAI-compatible endpoint).
# NOTE: the model must support vision for receipt OCR to work.
