# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App login gate (single password, no user accounts)
APP_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# Optional: enables receipt-photo OCR via an OpenAI-compatible vision endpoint.
# Leave blank to disable OCR (bot will still accept photos, just asks you to
# type the amount/category instead of auto-extracting).
OCR_API_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
